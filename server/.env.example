# 1SLiquidity Bot Environment Configuration
# Copy this file to .env and fill in your values

# ===== RPC Configuration =====
RPC_HTTP_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
# Optional emergency fallback when primary Infura/Alchemy is rate-limited
MAINNET_RPC_HTTP_URL_FALLBACK=https://mainnet.infura.io/v3/YOUR_BACKUP_INFURA_KEY
CHAIN_ID=1

# ===== Wallet Configuration =====
# WARNING: Keep this private! Never commit .env to git
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ===== Contract Addresses (v1.0.5) =====
CORE_CONTRACT=0x66be9da4d7312d48c855be1fc4c1e979b6e94cc2
REGISTRY_CONTRACT=0x5EAee88B493de2D646a8C29Bb5b09a79c5322dF4
EXECUTOR_CONTRACT=0xA03762EFF4f98cDA57DeA0a8eB62ab872C832878
STREAM_DAEMON_CONTRACT=0xd35f101Db2EA11693c09851389494d9E297de95C

# ===== Alert Configuration =====
# Telegram Bot Setup (https://core.telegram.org/bots#6-botfather)
# 1. Message @BotFather on Telegram
# 2. Create new bot with /newbot
# 3. Copy the bot token here
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# 4. Message @userinfobot to get your chat ID
# 5. Start a chat with your bot (send any message)
# 6. Copy your chat ID here
TELEGRAM_CHAT_ID=987654321

# Alert Settings
ALERT_ON_SUCCESS=false          # Send alert on successful executions
ALERT_ON_FAILURE=true           # Send alert on failed executions
ALERT_DAILY_SUMMARY=true        # Send daily summary at 00:00 UTC
ALERT_LOW_BALANCE_THRESHOLD=0.02   # Alert if ETH balance below this (ETH)

# ===== Monitoring Configuration =====
LOG_RETENTION_DAYS=7            # How many days to keep logs
HEALTH_CHECK_INTERVAL=60        # Minutes between health checks
