# RPC (required for scan / live)
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# Repo root (defaults to parent of liquidity-bot)
# REPO_ROOT=..

# Bot keys — one per bot id (BOT_<ID>_KEY), set after `npm run generate bot -- <id>`
# BOT_ALPHA_KEY=0x...

# Spot prices: fetched daily from CoinGecko → data/price-cache.json (no ETH_USD env).

# Safety: 1 = no on-chain transactions from execution phases
DRY_RUN=1

# Telegram alerts (optional — leg1/leg2, settlement P/L, daily summary)
# TELEGRAM_ENABLED=1
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# TELEGRAM_CHAT_ID=987654321

# Deploy target (npm run deploy bot -- <id>)
# DEPLOY_HOST=ubuntu@your-ec2.amazonaws.com
# DEPLOY_PATH=/opt/1sliquidity
